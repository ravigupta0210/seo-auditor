# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Frontend origin allowed by CORS (no trailing slash)
# In production set to the deployed frontend URL, e.g. https://seo-auditor.vercel.app
CORS_ORIGIN=http://localhost:3000

# Optional: Google PageSpeed Insights API key (free, defers a single info-severity check)
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Optional: enable Playwright JS rendering for SPA sites (default off, needs >=1GB RAM)
RENDER_JS=0

# --- Persistence (free hosted Postgres, e.g. Supabase / Neon) ---
# When unset, audits are kept in memory only (lost on restart) and email leads /
# feedback are not stored. Use Supabase → Connect → "Session pooler" URI.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Email (Gmail API over HTTPS) ---
# We send via the Gmail API (not SMTP — Render's free tier blocks SMTP ports).
# It sends through Google as the authenticated account, so it lands in the inbox
# (passes SPF/DKIM/DMARC) with no custom domain. Set up: Google Cloud → enable
# Gmail API → OAuth client → get a refresh token (gmail.send scope) for the
# sending account. When unset, emails are logged instead of sent (app still works).
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-...
# GMAIL_REFRESH_TOKEN=1//0...
# MAIL_FROM=Free SEO Audit <freeseoaudit.app@gmail.com>
# FEEDBACK_TO=freeseoaudit.app@gmail.com

# Public frontend origin, used to build report links in emails
# APP_URL=https://freeseoaudit.vercel.app
